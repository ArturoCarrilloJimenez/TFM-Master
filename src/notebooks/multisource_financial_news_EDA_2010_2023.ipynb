    "import io\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "\n",
    "from config.settings import settings\n",
    "from dependencies.dependencies import get_storage_repository\n",
    "\n",
    "sns.set_theme(style=\"whitegrid\", palette=\"muted\")\n",
    "plt.rcParams.update({\"figure.figsize\": (12, 6), \"font.size\": 11})\n",
    "\n",
    "storage = get_storage_repository()\n",
    "\n",
    "async def cargar_dataset(key: str) -> pd.DataFrame:\n",
    "    \"\"\"Descarga el payload de R2 y construye el DataFrame optimizando memoria.\"\"\"\n",
    "    raw_bytes = await storage.get(key.lstrip(\"/\"))\n",
    "    return pd.read_parquet(io.BytesIO(raw_bytes))\n",
    "\n",
    "R2_KEY = \"raw/huggingface/multisource_bancos_2010_2023.parquet\"\n",
    "\n",
    "# Top-level await nativo del kernel de Jupyter/IPython\n",
    "df = await cargar_dataset(R2_KEY)\n",
    "\n",
    "# Normalización temporal y métricas vectorizadas\n",
    "df[\"datetime\"] = pd.to_datetime(df[\"datetime\"], utc=True)\n",
    "df[\"year\"] = df[\"datetime\"].dt.year\n",
    "df[\"year_month\"] = df[\"datetime\"].dt.to_period(\"M\")\n",
    "\n",
    "text_series = df[\"text\"].fillna(\"\")\n",
    "df[\"char_count\"] = text_series.str.len()\n",
    "df[\"word_count\"] = text_series.str.count(r\"\\S+\")\n",
    "\n",
    "print(f\"✔ Dataset cargado exitosamente: {len(df):,} noticias | {df.shape[1]} columnas\")\n",
    "df.head()"
   ]
  },
