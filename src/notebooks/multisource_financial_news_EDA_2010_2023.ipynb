    "patron_zacks = re.compile(r'want.*?latest recommendations.*?zacks.*?com\\b', flags=re.IGNORECASE | re.DOTALL)\n",
    "\n",
    "# 2. Definimos la máscara combinada usando los patrones limpios\n",
    "def enmascarar_ruido_conocido(texto: str) -> str:\n",
    "    texto = str(texto)\n",
    "    texto = patron_nasdaq.sub('', texto)  # Capa 1\n",
    "    texto = patron_zacks.sub('', texto)   # Capa 2\n",
    "    return texto\n",
    "\n",
    "# Aplicamos la máscara a la serie\n",
    "textos_capa3 = df_limpio['text'].apply(enmascarar_ruido_conocido)\n",
