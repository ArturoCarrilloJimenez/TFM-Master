    "resumen_bancos[\"porcentaje\"] = (resumen_bancos[\"total_articulos\"] / len(df)) * 100\n",
    "resumen_bancos[\"palabras_media\"] = resumen_bancos[\"palabras_media\"].round(1)\n",
