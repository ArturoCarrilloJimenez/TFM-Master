    "# =============================================================================\n",
    "# EXTRACCIÓN DE N-GRAMAS (4 A 8 PALABRAS) - DEFINICIÓN Y EJECUCIÓN (CAPA 1)\n",
    "# =============================================================================\n",
    "import pandas as pd\n",
    "from sklearn.feature_extraction.text import CountVectorizer\n",
    "from IPython.display import display\n",
    "\n",
    "# 0. Constantes globales para evitar deuda técnica\n",
    "COL_FRASE = 'Frase (Plantilla Sospechosa)'\n",
    "COL_N_DOCS = 'Aparece en N Documentos'\n",
    "COL_PCT_DATASET = '% del Dataset'\n",
    "\n",
    "# --- 1. DEFINICIÓN DE LA FUNCIÓN CORE ---\n",
    "def extraer_top_plantillas(textos_serie: pd.Series, total_documentos: int, \n",
    "                           ngram_range=(4, 7), max_features=40) -> pd.DataFrame:\n",
    "    \"\"\"\n",
    "    Vectoriza una serie de textos para extraer los N-gramas más frecuentes (boilerplate).\n",
    "    Se ajusta min_df=20 y max_df=0.5 para evitar desbordamientos de memoria en datasets grandes.\n",
    "    \"\"\"\n",
    "    vectorizador = CountVectorizer(\n",
    "        ngram_range=ngram_range, \n",
    "        stop_words='english', \n",
    "        binary=True, \n",
    "        min_df=20,          # Subimos de 10 a 20 para descartar ruido de baja frecuencia que satura la RAM\n",
    "        max_df=0.5,         # Ignora frases que aparezcan en más del 50% de los documentos (evita falsos n-gramas comunes)\n",
    "        max_features=max_features\n",
    "    )\n",
    "    \n",
    "    # Extraer matriz\n",
    "    matriz_docs = vectorizador.fit_transform(textos_serie.astype(str))\n",
    "    docs_afectados = matriz_docs.sum(axis=0)\n",
    "    \n",
    "    # Empaquetar resultados\n",
    "    plantillas = [(frase, docs_afectados[0, idx]) for frase, idx in vectorizador.vocabulary_.items()]\n",
    "    df_res = pd.DataFrame(plantillas, columns=[COL_FRASE, COL_N_DOCS])\n",
    "    \n",
    "    # Ordenar y calcular porcentaje\n",
    "    df_res = df_res.sort_values(by=COL_N_DOCS, ascending=False).reset_index(drop=True)\n",
    "    df_res[COL_PCT_DATASET] = (df_res[COL_N_DOCS] / total_documentos) * 100\n",
    "    \n",
    "    return df_res\n",
    "\n",
    "# --- 2. EJECUCIÓN: CAPA 1 (BÚSQUEDA GENÉRICA) ---\n",
    "print(\"Buscando plantillas repetitivas (Boilerplate) en el texto base (Capa 1)...\")\n",
    "\n",
    "total_noticias = len(df_limpio)\n",
    "df_plantillas_c1 = extraer_top_plantillas(df_limpio['text'], total_noticias)\n",
    "\n",
    "display(df_plantillas_c1.head(20))"
   ]
  },
