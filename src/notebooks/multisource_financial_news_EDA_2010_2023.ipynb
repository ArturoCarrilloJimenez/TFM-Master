   "source": [
    "# Destapando capa 4 de ruido: Eliminando disclaimers de Nasdaq, Zacks y MarketBeat, por mera curiosidad. Esto es un ejercicio de auditoría exhaustiva, no una recomendación de limpieza.\n",
    "\n",
    "print(\"Silenciando Nasdaq, Zacks y Motley Fool para descubrir la Capa 4 de ruido...\")\n",
    "\n",
    "# 1. Precompilamos todos los patrones acumulados (Optimización de rendimiento)\n",
    "patron_nasdaq = re.compile(r'views and opinions expressed[^.]*?nasdaq[^.]*?\\.', flags=re.IGNORECASE)\n",
    "patron_zacks = re.compile(r'want.*?latest recommendations.*?zacks.*?com\\b', flags=re.IGNORECASE | re.DOTALL)\n",
    "patron_fool_1 = re.compile(r'motley fool.*?advisor', flags=re.IGNORECASE)\n",
    "patron_fool_2 = re.compile(r'10 stocks better buys', flags=re.IGNORECASE)\n",
    "patron_fool_3 = re.compile(r'best stocks investors buy right now', flags=re.IGNORECASE)\n",
    "patron_fool_4 = re.compile(r'pay listen newsletter', flags=re.IGNORECASE)\n",
    "\n",
    "# 2. Definimos la máscara acumulada eficiente\n",
    "def enmascarar_ruido_acumulado(texto: str) -> str:\n",
    "    texto = str(texto)\n",
    "    texto = patron_nasdaq.sub('', texto)\n",
    "    texto = patron_zacks.sub('', texto)\n",
    "    texto = patron_fool_1.sub('', texto)\n",
    "    texto = patron_fool_2.sub('', texto)\n",
    "    texto = patron_fool_3.sub('', texto)\n",
    "    texto = patron_fool_4.sub('', texto)\n",
    "    return texto\n",
    "\n",
    "# Aplicamos la máscara acumulada a la serie\n",
    "textos_capa4 = df_limpio['text'].apply(enmascarar_ruido_acumulado)\n",
    "\n",
    "# 3. Reutilizamos nuestra función core pasándole los parámetros\n",
    "total_noticias = len(df_limpio)\n",
    "df_plantillas_c4 = extraer_top_plantillas(\n",
    "    textos_serie=textos_capa4, \n",
    "    total_documentos=total_noticias, \n",
    "    ngram_range=(4, 7), \n",
    "    max_features=40\n",
    ")\n",
    "\n",
    "# Mostramos el Top 30 para auditar la última capa\n",
    "display(df_plantillas_c4.head(30))"
   ]
