    "# =============================================================================\n",
    "# EXTRACCIÓN DE N-GRAMAS (4 A 8 PALABRAS) - EJECUCIÓN (CAPA 2: SIN NASDAQ)\n",
    "# =============================================================================\n",
    "\n",
    "import re\n",
    "\n",
    "print(\"Aplicando máscara para silenciar el disclaimer de Nasdaq y buscar la Capa 2 de ruido...\")\n",
    "\n",
    "# 1. Precompilamos el patrón Regex fuera del bucle (Optimización de rendimiento y SonarLint)\n",
    "patron_nasdaq = re.compile(r'views and opinions expressed[^.]*?nasdaq[^.]*?\\.', flags=re.IGNORECASE)\n",
    "\n",
    "# 2. Definimos la función de enmascaramiento temporal\n",
    "def enmascarar_nasdaq(texto: str) -> str:\n",
    "    \"\"\"Elimina el bloque legal de Nasdaq del texto.\"\"\"\n",
    "    return patron_nasdaq.sub('', str(texto))\n",
    "\n",
    "# 3. Generamos la serie de textos aplicando la máscara\n",
    "textos_sin_nasdaq = df_limpio['text'].apply(enmascarar_nasdaq)\n",
    "\n",
    "# 4. Ejecutamos nuestra función core reutilizable sobre el texto enmascarado\n",
    "total_noticias = len(df_limpio)\n",
    "df_plantillas_c2 = extraer_top_plantillas(textos_sin_nasdaq, total_noticias)\n",
    "\n",
    "# Mostramos el Top 20 para descubrir la siguiente capa de boilerplate (ej. Zacks o Motley Fool)\n",
    "display(df_plantillas_c2.head(20))"
   ]
