   "source": [
    "# =============================================================================\n",
    "# COMPARATIVA ANUAL POR CONTEO DE TICKERS (ticker_count) Y TIPO DE NOTICIA\n",
    "# =============================================================================\n",
    "\n",
    "# 1. Asegurar la existencia de ticker_count e is_multisubject (vienen del parquet consolidado)\n",
    "if 'ticker_count' not in df.columns:\n",
    "    df['ticker_count'] = df.groupby(['title', 'datetime'])['ticker'].transform('nunique')\n",
    "    df['is_multisubject'] = df['ticker_count'] > 1\n",
    "\n",
    "# 2. Matriz de contingencia anual por conteo de tickers (filas del dataset)\n",
    "matriz_anual_tipo = pd.crosstab(df['year'], df['ticker_count'])\n",
    "\n",
    "# 3. Matriz porcentual normalizada por año (proporción 100% apilada)\n",
    "matriz_anual_pct = pd.crosstab(df['year'], df['is_multisubject'], normalize='index') * 100\n",
    "\n",
    "print(\"=\" * 85)\n",
    "print(\"MATRIZ ANUAL DE FILAS POR NÚMERO DE TICKERS ASOCIADOS (ticker_count)\")\n",
    "print(\"=\" * 85)\n",
    "crosstab_display = pd.crosstab(df['year'], df['ticker_count'], margins=True, margins_name=\"Total\")\n",
    "display(crosstab_display)\n",
    "\n",
    "print(\"\\n\" + \"=\" * 85)\n",
    "print(\"RESUMEN DE PROPORCIÓN ANUAL: SEÑAL PURA (1 TICKER) VS. MULTISUJETO (2+ TICKERS)\")\n",
    "print(\"=\" * 85)\n",
    "resumen_pct = pd.DataFrame({\n",
    "    'Total Filas': df.groupby('year').size(),\n",
    "    'Únicas (1 Ticker)': matriz_anual_tipo[1],\n",
    "    '% Únicas': matriz_anual_pct[False].round(1),\n",
    "    'Multisujeto (2+ Tickers)': df.groupby('year').size() - matriz_anual_tipo[1],\n",
    "    '% Multisujeto': matriz_anual_pct[True].round(1)\n",
    "})\n",
    "display(resumen_pct)\n",
    "\n",
    "# 4. Lienzo gráfico dual (Barras apiladas de volumen + Barras 100% de proporción)\n",
    "fig, axes = plt.subplots(1, 2, figsize=(18, 6))\n",
    "\n",
    "# --- GRÁFICO 1 (Izquierda): Volumen Anual Apilado por ticker_count ---\n",
    "colores_conteo = ['#2b5c8f', '#418ab3', '#6baed6', '#9ecae1', '#c6dbef', '#fc9272']\n",
    "matriz_anual_tipo.plot(\n",
    "    kind='bar',\n",
    "    stacked=True,\n",
    "    ax=axes[0],\n",
    "    color=colores_conteo,\n",
    "    width=0.75,\n",
    "    edgecolor='black',\n",
    "    linewidth=0.5\n",
    ")\n",
    "axes[0].set_title(\"Volumen Anual por Cantidad de Tickers Asociados (ticker_count)\", fontweight='bold', pad=15)\n",
    "axes[0].set_xlabel(\"Año\", fontweight='bold')\n",
    "axes[0].set_ylabel(\"Cantidad de Registros (Filas)\", fontweight='bold')\n",
    "axes[0].legend(\n",
    "    title=\"N° Tickers Asociados\",\n",
    "    labels=[f\"{i} Ticker{'s' if i > 1 else ' (Única / Pura)'}\" for i in sorted(df['ticker_count'].unique())],\n",
    "    loc='upper left',\n",
    "    frameon=True\n",
    ")\n",
    "axes[0].tick_params(axis='x', rotation=45)\n",
    "axes[0].grid(axis='y', linestyle='--', alpha=0.5)\n",
    "\n",
    "# --- GRÁFICO 2 (Derecha): Proporción 100% Apilada (Señal Pura vs. Multisujeto) ---\n",
    "colores_proporcion = ['#2b5c8f', '#d95f02']\n",
    "matriz_anual_pct.plot(\n",
    "    kind='bar',\n",
    "    stacked=True,\n",
    "    ax=axes[1],\n",
    "    color=colores_proporcion,\n",
    "    width=0.75,\n",
    "    edgecolor='black',\n",
    "    linewidth=0.5\n",
    ")\n",
    "axes[1].set_title(\"Proporción Anual: Señal Pura (1 Ticker) vs. Ruido Multisujeto\", fontweight='bold', pad=15)\n",
    "axes[1].set_xlabel(\"Año\", fontweight='bold')\n",
    "axes[1].set_ylabel(\"Porcentaje del Total Anual (%)\", fontweight='bold')\n",
    "axes[1].legend(\n",
    "    title=\"Clasificación\",\n",
    "    labels=[\"Señal Pura (1 Ticker)\", \"Multisujeto (2+ Tickers)\"],\n",
    "    loc='lower right',\n",
    "    frameon=True\n",
    ")\n",
    "axes[1].tick_params(axis='x', rotation=45)\n",
    "axes[1].set_ylim(0, 100)\n",
    "axes[1].grid(axis='y', linestyle='--', alpha=0.5)\n",
    "\n",
    "# Añadir etiquetas con el % de señal pura dentro de las barras\n",
    "for n, c in enumerate(matriz_anual_pct.index):\n",
    "    val_pura = matriz_anual_pct.loc[c, False]\n",
    "    axes[1].text(n, val_pura / 2, f\"{val_pura:.0f}%\", ha='center', va='center', color='white', fontweight='bold', fontsize=9)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()\n"
   ]
  },
