    "# =============================================================================\n",
    "# PRUEBA DE CONCEPTO: ZERO-SHOT CLASSIFICATION (V1 vs V2)\n",
    "# =============================================================================\n",
    "import time\n",
    "import torch\n",
    "import pandas as pd\n",
    "from transformers import pipeline\n",
    "from IPython.display import display, HTML\n",
    "\n",
    "# ---------------------------------------------------------\n",
    "# 1. FUNCIONES DE LÓGICA DE NEGOCIO\n",
    "# ---------------------------------------------------------\n",
    "\n",
    "def limpiar_dataset_base(df_crudo: pd.DataFrame) -> pd.DataFrame:\n",
    "    \"\"\"Filtra ruido estructural (multisubject) y falsos positivos del ticker 'C' (Citigroup).\"\"\"\n",
    "    df_pura = df_crudo[~df_crudo['is_multisubject']].copy()\n",
    "    \n",
    "    es_basura_citi = (df_pura['ticker'] == 'C') & \\\n",
    "                     (~df_pura['title'].str.contains('citi', case=False, na=False)) & \\\n",
    "                     (~df_pura['text'].str.contains('citi', case=False, na=False))\n",
    "                     \n",
    "    return df_pura[~es_basura_citi].copy()\n",
    "\n",
    "def cargar_modelo_zeroshot(nombre_modelo: str = \"facebook/bart-large-mnli\"):\n",
    "    \"\"\"Carga el pipeline de HuggingFace detectando dinámicamente si existe GPU disponible.\"\"\"\n",
    "    dispositivo = 0 if torch.cuda.is_available() else -1\n",
    "    tipo_hardware = \"GPU\" if dispositivo == 0 else \"CPU\"\n",
    "    print(f\"Cargando modelo '{nombre_modelo}' en {tipo_hardware}...\")\n",
    "    return pipeline(\"zero-shot-classification\", model=nombre_modelo, device=dispositivo)\n",
    "\n",
    "def ejecutar_inferencia(textos: list, modelo, etiquetas: list, template: str = None, max_chars: int = 1000) -> list:\n",
    "    \"\"\"Ejecuta la predicción sobre una lista de textos truncados y devuelve los resultados.\"\"\"\n",
    "    textos_truncados = [str(t)[:max_chars] for t in textos]\n",
    "    if template:\n",
    "        return modelo(textos_truncados, etiquetas, multi_label=False, hypothesis_template=template)\n",
    "    return modelo(textos_truncados, etiquetas, multi_label=False)\n",
    "\n",
    "# ---------------------------------------------------------\n",
    "# 2. FUNCIONES DE PRESENTACIÓN\n",
    "# ---------------------------------------------------------\n",
    "\n",
    "def mostrar_reporte_html(df_muestra: pd.DataFrame, resultados: list, color_fondo: str = \"#e8f4f8\"):\n",
    "    \"\"\"Renderiza las etiquetas asignadas cruzadas con los metadatos de la noticia original.\"\"\"\n",
    "    for i, ((_, row), res) in enumerate(zip(df_muestra.iterrows(), resultados), 1):\n",
    "        categoria_top = res['labels'][0]\n",
    "        score_top = res['scores'][0]\n",
    "        \n",
    "        display(HTML(f\"<b>Noticia {i} ({row['ticker']}) | Fecha:</b> {row['datetime']}\"))\n",
    "        display(HTML(f\"<b>Título:</b> {row['title']}\"))\n",
    "        display(HTML(f\"<span style='color: #2c3e50; background-color: {color_fondo}; padding: 3px 6px; border-radius: 4px;'>\"\n",
    "                     f\"<b>Categoría:</b> {categoria_top} (Confianza: {score_top:.1%})</span><hr>\"))\n",
    "\n",
    "# ---------------------------------------------------------\n",
    "# 3. ORQUESTACIÓN (Main Execution)\n",
    "# ---------------------------------------------------------\n",
    "\n",
    "# Preparación de datos y modelo\n",
    "df_limpio = limpiar_dataset_base(df)\n",
    "clasificador = cargar_modelo_zeroshot()\n",
    "muestra = df_limpio.sample(5, random_state=42)\n",
    "\n",
    "# Definición de configuraciones\n",
    "etiquetas_v1 = [\n",
    "    \"Earnings and Financial Performance\",\n",
    "    \"Mergers, Acquisitions and Partnerships\",\n",
    "    \"Legal, Regulatory and Fines\",\n",
    "    \"Macroeconomics and Monetary Policy\",\n",
    "    \"Management and Corporate Governance\"\n",
    "]\n",
    "\n",
    "etiquetas_v2 = [\n",
    "    \"company earnings and financial results\",\n",
    "    \"corporate mergers and acquisitions\",\n",
    "    \"legal issues, regulatory fines or lawsuits\",\n",
    "    \"macroeconomics, inflation and interest rates\",\n",
    "    \"corporate governance, executives and management\",\n",
    "    \"stock market trading and investment activity\"\n",
    "]\n",
    "\n",
    "# --- EJECUCIÓN V1: ETIQUETAS ESTÁNDAR ---\n",
    "print(\"\\n--- RESULTADOS DE LA CLASIFICACIÓN V1 (ESTÁNDAR) ---\")\n",
    "inicio_v1 = time.time()\n",
    "\n",
    "resultados_v1 = ejecutar_inferencia(muestra['text'].tolist(), clasificador, etiquetas_v1)\n",
    "mostrar_reporte_html(muestra, resultados_v1, color_fondo=\"#e8f4f8\")\n",
    "\n",
    "print(f\"Tiempo de ejecución V1: {time.time() - inicio_v1:.2f} segundos.\")\n",
    "\n",
    "\n",
    "# --- EJECUCIÓN V2: ETIQUETAS OPTIMIZADAS + TEMPLATE ---\n",
    "print(\"\\n--- RESULTADOS DE LA CLASIFICACIÓN V2 (LENGUAJE NATURAL) ---\")\n",
    "inicio_v2 = time.time()\n",
    "\n",
    "resultados_v2 = ejecutar_inferencia(\n",
    "    muestra['text'].tolist(), \n",
    "    clasificador, \n",
    "    etiquetas_v2, \n",
    "    template=\"This text is about {}.\"\n",
    ")\n",
    "mostrar_reporte_html(muestra, resultados_v2, color_fondo=\"#d4edda\")\n",
    "\n",
    "print(f\"Tiempo de ejecución V2: {time.time() - inicio_v2:.2f} segundos.\")"
   ]
