   "source": [
    "def signo(s, umbral=UMBRAL_NEUTRO):\n",
    "    return np.where(s > umbral, 1, np.where(s < -umbral, -1, 0))\n",
    "\n",
    "FAMILIAS = {\n",
    "    \"REGEX_OLD_V1\":           \"1. Baseline\",\n",
    "    \"SPACY_S1B\":              \"1. Baseline (spaCy)\",\n",
    "    \"SPACY_S0\":               \"1. Baseline (spaCy)\",\n",
    "    \"RE_V1_PODA\":             \"2. Regex base_nlp\",\n",
    "    \"RE_V0_PODA\":             \"2. Regex base_nlp\",\n",
    "    \"RE_TIT_GATE\":            \"2. Regex base_nlp\",\n",
    "    \"RE_ADAPTATIVA\":          \"2. Regex base_nlp\",\n",
    "    \"RE_FRASE_MEDIA\":         \"2. Regex base_nlp\",\n",
    "    \"RE_FRASE_PONDERADA\":     \"2. Regex base_nlp\",\n",
    "    \"ABSA_DEBERTA_BASE\":      \"3. Aspecto (ABSA)\",\n",
    "    \"ENSAMBLE_FB_ABSA\":       \"3. Aspecto (ABSA)\",\n",
    "    \"ENSAMBLE_FB_ABSA_ALT_B\": \"3. Aspecto (ABSA)\",\n",
    "    \"GEMINI_LLM\":             \"4. LLM (Gemini)\",\n",
    "}\n",
    "\n",
    "def evaluar_ground_truth(y_true, y_pred, nombre_est):\n",
    "    acc = float((y_true == y_pred).mean())\n",
    "    precs, recs, f1s, f2s = {}, {}, {}, {}\n",
    "    for c in (-1, 0, 1):\n",
    "        tp = int(((y_true == c) & (y_pred == c)).sum())\n",
    "        fp = int(((y_true != c) & (y_pred == c)).sum())\n",
    "        fn = int(((y_true == c) & (y_pred != c)).sum())\n",
    "        p = tp / (tp + fp) if (tp + fp) > 0 else 0.0\n",
    "        r = tp / (tp + fn) if (tp + fn) > 0 else 0.0\n",
    "        f1 = 2 * p * r / (p + r) if (p + r) > 0 else 0.0\n",
    "        f2 = 5 * p * r / (4 * p + r) if (4 * p + r) > 0 else 0.0\n",
    "        precs[c], recs[c], f1s[c], f2s[c] = p, r, f1, f2\n",
    "    inv = int((((y_true == 1) & (y_pred == -1)) | ((y_true == -1) & (y_pred == 1))).sum())\n",
    "    fneu = int(((y_true != 0) & (y_pred == 0)).sum())\n",
    "    return {\n",
    "        \"Familia\": FAMILIAS.get(nombre_est, \"Otra\"),\n",
    "        \"Estrategia\": nombre_est,\n",
    "        \"Accuracy\": round(acc, 3),\n",
    "        \"Precision (Macro)\": round(float(np.mean(list(precs.values()))), 3),\n",
    "        \"Recall (Macro)\": round(float(np.mean(list(recs.values()))), 3),\n",
    "        \"F1-Score\": round(float(np.mean(list(f1s.values()))), 3),\n",
    "        \"F2-Score (β=2)\": round(float(np.mean(list(f2s.values()))), 3),\n",
    "        \"Rec Pos (+1)\": round(recs[1], 3),\n",
    "        \"Rec Neu (0)\": round(recs[0], 3),\n",
    "        \"Rec Neg (-1)\": round(recs[-1], 3),\n",
    "        \"Falsos Neutros\": fneu,\n",
    "        \"Inversiones\": inv,\n",
    "    }, pd.crosstab(pd.Series(y_true, name=\"Real\"), pd.Series(y_pred, name=\"Predicho\"))\n",
    "\n",
    "if df_gt is not None and df_gt[\"etiqueta_manual\"].notna().all():\n",
    "    y_true = df_gt[\"etiqueta_manual\"].astype(int).to_numpy()\n",
    "    kpis_gt = []\n",
    "    for est_nombre in FAMILIAS:\n",
    "        if est_nombre not in res:\n",
    "            continue\n",
    "        if est_nombre == \"GEMINI_LLM\":\n",
    "            y_pred = res[est_nombre][\"label\"].astype(int).to_numpy()\n",
    "        else:\n",
    "            u_eff = 0.35 if \"ENSAMBLE\" in est_nombre else UMBRAL_NEUTRO\n",
    "            y_pred = signo(res[est_nombre][\"sentiment\"].to_numpy(), umbral=u_eff)\n",
    "        k, _ = evaluar_ground_truth(y_true, y_pred, est_nombre)\n",
    "        kpis_gt.append(k)\n",
    "\n",
    "    df_kpis_out = pd.DataFrame(kpis_gt).sort_values([\"Accuracy\", \"F1-Score\"], ascending=False).reset_index(drop=True)\n",
    "    display(df_kpis_out)\n",
    "\n",
    "    for est_cm in [e for e in [\"GEMINI_LLM\", \"ENSAMBLE_FB_ABSA_ALT_B\", \"RE_FRASE_PONDERADA\"] if e in res]:\n",
    "        yp = res[est_cm][\"label\"].astype(int).to_numpy() if est_cm == \"GEMINI_LLM\" else signo(res[est_cm][\"sentiment\"].to_numpy(), 0.35 if \"ENSAMBLE\" in est_cm else UMBRAL_NEUTRO)\n",
    "        _, cm = evaluar_ground_truth(y_true, yp, est_cm)\n",
    "        print(f\"\\nMatriz de confusión — {est_cm} (N = {len(y_true)}):\")\n",
    "        display(cm)\n",
    "else:\n",
    "    print(\"[INFO] Sin etiquetas manuales completas en CSV_GT.\")"
   ]
  },
