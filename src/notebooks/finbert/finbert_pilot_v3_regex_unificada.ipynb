    "CACHE_GEMINI = PROJ_ROOT / \"scratch\" / \"gemini_pilot_v3_cache.csv\"\n",
    "\n",
    "class SentimientoItem(BaseModel):\n",
    "    idx: int = Field(description=\"Índice numérico de la noticia dentro del lote\")\n",
    "    label: int = Field(description=\"Polaridad exclusiva para el banco objetivo: 1 (Positivo), 0 (Neutral), -1 (Negativo)\")\n",
    "    sentiment_score: float = Field(description=\"Puntuación continua entre -1.0 (muy negativo) y +1.0 (muy positivo)\")\n",
    "    p_pos: float = Field(description=\"Probabilidad positiva [0.0, 1.0]\")\n",
    "    p_neg: float = Field(description=\"Probabilidad negativa [0.0, 1.0]\")\n",
    "    p_neu: float = Field(description=\"Probabilidad neutral [0.0, 1.0]\")\n",
    "    motivo: str = Field(description=\"Justificación breve en español (máx 12 palabras)\")\n",
    "\n",
    "class LoteSentimientoGemini(BaseModel):\n",
    "    resultados: list[SentimientoItem]\n",
    "\n",
    "SYSTEM_PROMPT_GEMINI = \"\"\"Eres un analista financiero cuantitativo experto en los 6 grandes bancos de EE. UU. (JPMorgan Chase, Bank of America, Wells Fargo, Citigroup, Goldman Sachs, Morgan Stanley).\n",
    "Para cada noticia del lote, evalúa EXCLUSIVAMENTE el impacto bursátil/fundamental sobre el BANCO OBJETIVO indicado:\n",
    "- +1 (Positivo): Beneficios o ingresos que baten estimaciones, subidas bursátiles del banco, aumento de dividendo/recompra, mejora de recomendación hacia el banco.\n",
    "- -1 (Negativo): Pérdidas, caída bursátil del banco, recortes de plantilla, multas regulatorias, demandas, provisiones por mora, rebaja de previsión del banco.\n",
    "- 0 (Neutral): Calendarios o previas de resultados ('scheduled to report'), mandatos rutinarios de M&A o IPO ('hired as underwriter/advisor'), opinión del banco actuando como analista sobre terceros/macro/bonos/divisas, o noticias sobre competidores sin impacto directo en el banco objetivo.\n",
    "\n",
    "Ignora por completo el sentimiento de otros bancos competidores mencionados en el texto. Devuelve exactamente un elemento en `resultados` por cada `idx` del lote, manteniendo el `idx` exacto.\"\"\"\n",
    "\n",
    "async def evaluar_con_gemini(df_in, textos_adapt, model_name=GEMINI_MODEL, batch_size=15, pause_s=4.5):\n",
    "    from google import genai\n",
    "    from google.genai import types\n",
    "\n",
    "    cache = {}\n",
    "    if CACHE_GEMINI.exists():\n",
    "        df_c = pd.read_csv(CACHE_GEMINI)\n",
    "        for _, r in df_c.iterrows():\n",
    "            if r.get(\"model\") == model_name:\n",
    "                cache[(r[\"ticker\"], r[\"titular\"])] = r.to_dict()\n",
    "\n",
    "    pendientes = [\n",
    "        (i, r.ticker, r.title, textos_adapt[i])\n",
    "        for i, r in enumerate(df_in.itertuples())\n",
    "        if (r.ticker, r.title) not in cache\n",
    "    ]\n",
    "    print(f\"[Gemini] Modelo: {model_name} | En caché: {len(df_in) - len(pendientes)} | Pendientes: {len(pendientes)} (~{(len(pendientes) + batch_size - 1)//batch_size} llamadas)\", flush=True)\n",
    "\n",
    "    if pendientes:\n",
    "        client = genai.Client(api_key=GEMINI_API_KEY, http_options=types.HttpOptions(api_version=\"v1beta\"))\n",
    "        t0 = time.perf_counter()\n",
    "        for start in range(0, len(pendientes), batch_size):\n",
    "            lote = pendientes[start:start + batch_size]\n",
    "            bloques = [\n",
    "                f\"[idx={idx}] BANCO: {NOMBRE_CANONICO.get(tk, tk)} ({tk}) | TITULAR: {tit} | CONTEXTO: {ctx[:900]}\"\n",
    "                for idx, tk, tit, ctx in lote\n",
    "            ]\n",
    "            prompt = \"Evalúa las siguientes noticias:\\n\\n\" + \"\\n\\n\".join(bloques)\n",
    "            lote_ok = False\n",
    "            for intento in range(4):\n",
    "                try:\n",
    "                    resp = await client.aio.models.generate_content(\n",
    "                        model=model_name,\n",
    "                        contents=prompt,\n",
    "                        config=types.GenerateContentConfig(\n",
    "                            system_instruction=SYSTEM_PROMPT_GEMINI,\n",
    "                            response_mime_type=\"application/json\",\n",
    "                            response_schema=LoteSentimientoGemini,\n",
    "                            temperature=0.0,\n",
    "                        ),\n",
    "                    )\n",
    "                    parsed = LoteSentimientoGemini.model_validate_json(resp.text)\n",
    "                    por_idx = {it.idx: it for it in parsed.resultados}\n",
    "                    for idx, tk, tit, _ in lote:\n",
    "                        it = por_idx.get(idx)\n",
    "                        if it is not None:\n",
    "                            cache[(tk, tit)] = {\n",
    "                                \"ticker\": tk,\n",
    "                                \"titular\": tit,\n",
    "                                \"model\": model_name,\n",
    "                                \"label\": int(np.clip(it.label, -1, 1)),\n",
    "                                \"sentiment\": float(np.clip(it.sentiment_score, -1.0, 1.0)),\n",
    "                                \"P_pos\": float(np.clip(it.p_pos, 0.0, 1.0)),\n",
    "                                \"P_neg\": float(np.clip(it.p_neg, 0.0, 1.0)),\n",
    "                                \"P_neu\": float(np.clip(it.p_neu, 0.0, 1.0)),\n",
    "                                \"motivo\": it.motivo,\n",
    "                            }\n",
    "                    lote_ok = True\n",
    "                    print(f\"  Lote {start//batch_size + 1}/{(len(pendientes)+batch_size-1)//batch_size} OK ({len(por_idx)}/{len(lote)} items)\", flush=True)\n",
    "                    break\n",
    "                except Exception as exc:\n",
    "                    wait = (2 ** intento) * 5\n",
    "                    print(f\"  [WARN] Lote {start//batch_size + 1} intento {intento+1} falló: {exc} -> reintento en {wait}s\", flush=True)\n",
    "                    await asyncio.sleep(wait)\n",
    "            if not lote_ok:\n",
    "                for _, tk, tit, _ in lote:\n",
    "                    cache.setdefault((tk, tit), {\"ticker\": tk, \"titular\": tit, \"model\": model_name, \"label\": 0, \"sentiment\": 0.0, \"P_pos\": 0.0, \"P_neg\": 0.0, \"P_neu\": 1.0, \"motivo\": \"error\"})\n",
    "            pd.DataFrame(list(cache.values())).to_csv(CACHE_GEMINI, index=False, encoding=\"utf-8-sig\")\n",
    "            if start + batch_size < len(pendientes):\n",
    "                await asyncio.sleep(pause_s)\n",
    "        print(f\"[Gemini] Evaluación completada en {time.perf_counter() - t0:.1f} s\", flush=True)\n",
    "\n",
    "    filas_out = [cache.get((r.ticker, r.title), {\"ticker\": r.ticker, \"titular\": r.title, \"model\": model_name, \"label\": 0, \"sentiment\": 0.0, \"P_pos\": 0.0, \"P_neg\": 0.0, \"P_neu\": 1.0, \"motivo\": \"sin_respuesta\"}) for r in df_in.itertuples()]\n",
    "    return pd.DataFrame(filas_out).assign(confidence=lambda d: 1.0 - d[\"P_neu\"], localizado=True)\n",
    "\n",
    "if GEMINI_API_KEY:\n",
    "    res[\"GEMINI_LLM\"] = await evaluar_con_gemini(df_silver, [t for t, _ in extr[\"RE_ADAPTATIVA\"]])\n",
    "    display(res[\"GEMINI_LLM\"][[\"ticker\", \"label\", \"sentiment\", \"motivo\"]].head(8))\n",
    "else:\n",
    "    print(\"[INFO] GEMINI_API_KEY no configurada en .env -> se omite GEMINI_LLM. Añade GEMINI_API_KEY=... en .env y re-ejecuta esta celda.\")"
   ]
  },
