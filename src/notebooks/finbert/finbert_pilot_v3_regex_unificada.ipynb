    "REGEX_OLD = re.compile(r\"(?<=[.!?])\\s+(?=[A-Z0-9\\\"'(])\")\n",
    "NOMBRE_CANONICO = {\n",
    "    \"JPM\": \"JPMorgan Chase\",\n",
    "    \"BAC\": \"Bank of America\",\n",
    "    \"WFC\": \"Wells Fargo\",\n",
    "    \"C\": \"Citigroup\",\n",
    "    \"GS\": \"Goldman Sachs\",\n",
    "    \"MS\": \"Morgan Stanley\",\n",
    "}\n",
    "\n",
    "def extraer_regex_antigua(titular, cuerpo, ticker, ventana=1):\n",
    "    cuerpo = (cuerpo or \"\").strip()\n",
    "    if not cuerpo:\n",
    "        return titular.strip(), False\n",
    "    oraciones = [s.strip() for s in REGEX_OLD.split(cuerpo) if s.strip()]\n",
    "    aliases = ALIAS_BANCOS.get(ticker, [ticker.lower()])\n",
    "    pat = re.compile(r\"\\b(\" + \"|\".join(re.escape(a) for a in aliases) + r\")\\b\", re.IGNORECASE)\n",
    "    hits = [i for i, s in enumerate(oraciones) if pat.search(s)]\n",
    "    if not hits:\n",
    "        return f\"{titular.strip()}. {oraciones[0] if oraciones else ''}\".strip(), False\n",
    "    idx = sorted({j for i in hits for j in range(i - ventana, i + ventana + 1) if 0 <= j < len(oraciones)})\n",
    "    return f\"{titular.strip()}. \" + \" \".join(oraciones[i] for i in idx), True\n",
    "\n",
    "def podar_boilerplate_v2(cuerpo):\n",
    "    out = cuerpo\n",
    "    for bp in BOILERPLATE_SECTOR_PATTERNS:\n",
    "        out = re.sub(bp + r\".*?(\\n|$)\", \"\", out, flags=re.IGNORECASE)\n",
    "    out = re.sub(r\"^.*Free Stock Analysis Report.*$\", \"\", out, flags=re.IGNORECASE | re.MULTILINE)\n",
    "    out = re.sub(r\"^.*(Zacks Investment Research|To read this article on Zacks).*$\", \"\", out, flags=re.IGNORECASE | re.MULTILINE)\n",
    "    return out\n",
    "\n",
    "def extraer_spacy_v2(titular, cuerpo, ticker, ventana=1):\n",
    "    cuerpo = podar_boilerplate_v2((cuerpo or \"\").strip())\n",
    "    if not cuerpo:\n",
    "        return titular.strip(), False\n",
    "    oraciones = [s.text.strip() for s in nlp(cuerpo).sents if s.text.strip()]\n",
    "    hits = [i for i, s in enumerate(oraciones) if BaseProcesadorArticulo.menciona_banco(s, ticker)]\n",
    "    if not hits:\n",
    "        return f\"{titular.strip()}. {oraciones[0] if oraciones else ''}\".strip(), False\n",
    "    idx = sorted({j for i in hits for j in range(i - ventana, i + ventana + 1) if 0 <= j < len(oraciones)})\n",
    "    return f\"{titular.strip()} [SEP] \" + \" \".join(oraciones[i] for i in idx), True\n",
    "\n",
    "def detectar_aspecto(texto, ticker):\n",
    "    for al in ALIAS_BANCOS.get(ticker, [ticker.lower()]):\n",
    "        m = re.search(r\"\\b\" + re.escape(al) + r\"\\b\", texto, flags=re.IGNORECASE)\n",
    "        if m:\n",
    "            return m.group(0)\n",
    "    return NOMBRE_CANONICO.get(ticker, ticker)\n",
    "\n",
    "EXTRACTORES = {\n",
    "    \"REGEX_OLD_V1\":  lambda t, c, k: extraer_regex_antigua(t, c, k, ventana=1),\n",
    "    \"SPACY_S1B\":     lambda t, c, k: extraer_spacy_v2(t, c, k, ventana=1),\n",
    "    \"SPACY_S0\":      lambda t, c, k: extraer_spacy_v2(t, c, k, ventana=0),\n",
    "    \"RE_V1_PODA\":    lambda t, c, k: BaseProcesadorArticulo.extraer_contexto_banco(t, c, k, ventana_frases=1),\n",
    "    \"RE_V0_PODA\":    lambda t, c, k: BaseProcesadorArticulo.extraer_contexto_banco(t, c, k, ventana_frases=0),\n",
    "    \"RE_TIT_GATE\":   lambda t, c, k: BaseProcesadorArticulo.extraer_contexto_banco(t, c, k, ventana_frases=0, titular_condicional=True),\n",
    "    \"RE_ADAPTATIVA\": lambda t, c, k: BaseProcesadorArticulo.extraer_contexto_banco(t, c, k, titular_condicional=True, ventana_auto_multiticker=True),\n",
    "}\n",
    "\n",
    "# Inspección visual de un caso donde el titular NO nombra al banco (id=8: WFC en \"Financial ETFs Down...\")\n",
    "ej = df_silver.iloc[8]\n",
    "print(f\"EJEMPLO REAL | Ticker: [{ej.ticker}] | Titular: {ej.title}\")\n",
    "print(\"-\" * 95)\n",
    "for nom in [\"REGEX_OLD_V1\", \"RE_V0_PODA\", \"RE_TIT_GATE\", \"RE_ADAPTATIVA\"]:\n",
    "    txt_ej, _ = EXTRACTORES[nom](ej.title, ej.article, ej.ticker)\n",
    "    print(f\"{nom:15s} -> {txt_ej[:220]}...\")\n",
    "print(f\"{'FRASES_INDIV':15s} -> {BaseProcesadorArticulo.extraer_frases_banco(ej.title, ej.article, ej.ticker, titular_condicional=True)}\")"
   ]
  },
