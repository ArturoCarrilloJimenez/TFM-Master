    "POLAR_TERMS = re.compile(\n",
    "    r\"\\b(?:beat|beats|surge|surges|surged|soar|soars|jump|jumps|jumped|rally|rallies|record|upgrade|upgraded|\"\n",
    "    r\"plunge|plunges|plunged|slump|slumps|drop|drops|dropped|tumble|tumbles|loss|losses|fine|fined|\"\n",
    "    r\"lawsuit|miss|misses|missed|downgrade|downgraded|layoff|layoffs|cut|cuts)\\b\",\n",
    "    re.IGNORECASE,\n",
    ")\n",
    "\n",
    "df_diag = pd.DataFrame({\n",
    "    \"ticker\": df_silver[\"ticker\"],\n",
    "    \"title\": df_silver[\"title\"],\n",
    "    \"texto_v0\": [t for t, _ in extr[\"RE_V0_PODA\"]],\n",
    "    \"sent_v0\": res[\"RE_V0_PODA\"][\"sentiment\"].round(3),\n",
    "    \"conf_v0\": res[\"RE_V0_PODA\"][\"confidence\"].round(3),\n",
    "    \"sent_v1\": res[\"RE_V1_PODA\"][\"sentiment\"].round(3),\n",
    "})\n",
    "df_diag[\"clase_v0\"] = signo(df_diag[\"sent_v0\"])\n",
    "df_diag[\"clase_v1\"] = signo(df_diag[\"sent_v1\"])\n",
    "\n",
    "neutros_sosp = df_diag[(df_diag[\"clase_v0\"] == 0) & (df_diag[\"texto_v0\"].str.contains(POLAR_TERMS))]\n",
    "inversiones = df_diag[df_diag[\"clase_v0\"] * df_diag[\"clase_v1\"] == -1]\n",
    "\n",
    "print(f\"Posibles Falsos Neutros (neutro en FinBERT pero con léxico polar): {len(neutros_sosp)}/{len(df_diag)}\")\n",
    "for _, r in neutros_sosp.head(5).iterrows():\n",
    "    hits_lex = sorted(set(POLAR_TERMS.findall(r[\"texto_v0\"].lower())))\n",
    "    print(f\"  [{r['ticker']}] sent={r['sent_v0']:+.2f} | léxico={hits_lex} | {r['texto_v0'][:220]}...\")\n",
    "\n",
    "print(f\"\\nInversiones graves entre Ventana ±1 y Ventana 0: {len(inversiones)}/{len(df_diag)}\")\n",
    "for _, r in inversiones.head(5).iterrows():\n",
    "    print(f\"  [{r['ticker']}] V1={r['sent_v1']:+.2f} vs V0={r['sent_v0']:+.2f} | {r['title'][:90]}\")"
