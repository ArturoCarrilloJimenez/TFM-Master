    "def _pat_alias(tk):\n",
    "    aliases = ALIAS_BANCOS.get(tk, [tk.lower()])\n",
    "    return re.compile(r\"\\b(\" + \"|\".join(re.escape(a) for a in aliases) + r\")\\b\", re.IGNORECASE)\n",
    "\n",
    "def bancos_en(texto):\n",
    "    norm = BaseProcesadorArticulo._normalizar_texto(texto)\n",
    "    return [k for k in ALIAS_BANCOS if _pat_alias(k).search(texto) or _pat_alias(k).search(norm)]\n",
    "\n",
    "multi = df_silver[df_silver.apply(lambda r: len(bancos_en(f\"{r.title} {r.article}\")) >= 2, axis=1)].head(30)\n",
    "for nombre_mt, fn_mt in [(\"RE_V0_PODA\", lambda t, c, k: BaseProcesadorArticulo.extraer_contexto_banco(t, c, k, ventana_frases=0)),\n",
    "                         (\"SPACY_S0\",   lambda t, c, k: extraer_spacy_v2(t, c, k, ventana=0))]:\n",
    "    filas_mt = []\n",
    "    for r in multi.itertuples():\n",
    "        for k in bancos_en(f\"{r.title} {r.article}\"):\n",
    "            txt, _ = fn_mt(r.title, r.article, k)\n",
    "            filas_mt.append({\"articulo\": r.Index, \"banco\": k, \"texto\": txt})\n",
    "    df_mt = pd.DataFrame(filas_mt)\n",
    "    df_mt = df_mt.join(puntuar_lote(df_mt[\"texto\"].tolist(), batch_size=8, max_len=256)[[\"sentiment\", \"confidence\"]])\n",
