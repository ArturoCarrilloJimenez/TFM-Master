    "PROJ_ROOT = next((p for p in [curr, *curr.parents] if (p / \"pyproject.toml\").exists()), curr)\n",
    "for p in (PROJ_ROOT / \"src\", PROJ_ROOT):\n",
    "    if str(p) not in sys.path:\n",
    "        sys.path.insert(0, str(p))\n",
    "\n",
    "import config.settings as _settings_mod\n",
    "importlib.reload(_settings_mod)\n",
    "import articulos.models.base_nlp as _base_nlp_mod\n",
    "importlib.reload(_base_nlp_mod)\n",
    "\n",
    "from config.settings import settings\n",
