    "def signo(s, umbral=0.40):\n",
    "    return np.where(s > umbral, 1, np.where(s < -umbral, -1, 0))\n",
    "\n",
    "pares = [\n",
    "    (\"RE_V1_PODA\", \"SPACY_S1B\"),\n",
    "    (\"RE_V0_PODA\", \"SPACY_S0\"),\n",
    "    (\"REGEX_OLD_V1\", \"RE_V1_PODA\"),\n",
    "    (\"RE_V1_PODA\", \"RE_V0_PODA\"),\n",
    "]\n",
    "filas_acuerdo = []\n",
    "for a, b in pares:\n",
    "    sa, sb = signo(res[a][\"sentiment\"]), signo(res[b][\"sentiment\"])\n",
    "    filas_acuerdo.append({\n",
    "        \"Comparativa\": f\"{a} vs {b}\",\n",
    "        \"% Mismo Signo\": round(100 * float((sa == sb).mean()), 2),\n",
    "        \"% Inversión (pos<->neg)\": round(100 * float((sa * sb == -1).mean()), 2),\n",
    "        \"Corr. Pearson\": round(float(np.corrcoef(res[a][\"sentiment\"], res[b][\"sentiment\"])[0, 1]), 3),\n",
    "    })\n",
    "\n",
    "display(pd.DataFrame(filas_acuerdo))"
   ]
