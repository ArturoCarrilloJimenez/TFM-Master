    "@torch.inference_mode()\n",
    "def puntuar_finbert_lote(textos, batch_size=None, max_len=512):\n",
    "    bs = batch_size or (32 if DEVICE.type == \"cuda\" else 8)\n",
    "    orden = np.argsort([len(t) for t in textos])\n",
    "    probs = np.zeros((len(textos), 3), dtype=np.float32)\n",
    "    for i in range(0, len(textos), bs):\n",
    "        ids = orden[i:i + bs]\n",
    "        enc = tokenizer([textos[j] for j in ids], return_tensors=\"pt\", truncation=True, max_length=max_len, padding=True).to(DEVICE)\n",
    "        probs[ids] = torch.softmax(finbert(**enc).logits, dim=-1).cpu().numpy()\n",
    "    return pd.DataFrame({\"P_pos\": probs[:, I_POS], \"P_neg\": probs[:, I_NEG], \"P_neu\": probs[:, I_NEU]}).assign(\n",
    "        sentiment=lambda d: d.P_pos - d.P_neg,\n",
    "        confidence=lambda d: 1.0 - d.P_neu,\n",
    "    )\n",
    "\n",
    "@torch.inference_mode()\n",
    "def puntuar_absa_lote(textos, aspectos, batch_size=None, max_len=256):\n",
    "    bs = batch_size or (32 if DEVICE.type == \"cuda\" else 8)\n",
    "    orden = np.argsort([len(t) for t in textos])\n",
    "    probs = np.zeros((len(textos), 3), dtype=np.float32)\n",
    "    for i in range(0, len(textos), bs):\n",
    "        ids = orden[i:i + bs]\n",
    "        enc = absa_tokenizer(\n",
    "            [textos[j] for j in ids],\n",
    "            [aspectos[j] for j in ids],\n",
    "            return_tensors=\"pt\",\n",
    "            truncation=\"only_first\",\n",
    "            max_length=max_len,\n",
    "            padding=True,\n",
    "        ).to(DEVICE)\n",
    "        probs[ids] = torch.softmax(absa_model(**enc).logits, dim=-1).cpu().numpy()\n",
    "    return pd.DataFrame({\"P_pos\": probs[:, A_POS], \"P_neg\": probs[:, A_NEG], \"P_neu\": probs[:, A_NEU]}).assign(\n",
    "        sentiment=lambda d: d.P_pos - d.P_neg,\n",
    "        confidence=lambda d: 1.0 - d.P_neu,\n",
    "        localizado=True,\n",
    "    )\n",
    "\n",
    "extr, tiempos_extr = {}, {}\n",
    "for nombre, fn in EXTRACTORES.items():\n",
    "    t0 = time.perf_counter()\n",
    "    extr[nombre] = [fn(r.title, r.article, r.ticker) for r in df_silver.itertuples()]\n",
    "    tiempos_extr[nombre] = (time.perf_counter() - t0) * 1000 / len(df_silver)\n",
    "\n",
    "res, filas_resumen = {}, []\n",
    "for idx_v, (nombre, lista) in enumerate(extr.items(), 1):\n",
    "    textos = [t for t, _ in lista]\n",
    "    locs = [l for _, l in lista]\n",
    "    tok_lens = [len(tokenizer.encode(t, truncation=False)) for t in textos]\n",
    "\n",
    "    t0 = time.perf_counter()\n",
    "    df_s = puntuar_finbert_lote(textos, max_len=512)\n",
    "    dt = time.perf_counter() - t0\n",
    "    df_s[\"localizado\"] = locs\n",
    "    res[nombre] = df_s\n",
    "    print(f\"[{idx_v}/{len(EXTRACTORES)}] {nombre:15s} -> {dt:5.1f} s ({dt*1000/len(textos):5.1f} ms/doc)\", flush=True)\n",
    "\n",
    "    filas_resumen.append({\n",
    "        \"Variante\": nombre,\n",
    "        \"Extracción (ms/doc)\": round(tiempos_extr[nombre], 3),\n",
    "        \"Tokens medios\": round(float(np.mean(tok_lens)), 1),\n",
    "        \"% <= 256 tok\": round(100 * float(np.mean([x <= 256 for x in tok_lens])), 1),\n",
    "        \"Convicción (1-P_neu)\": round(float(df_s[\"confidence\"].mean()), 3),\n",
    "        \"|Sentiment| medio\": round(float(df_s[\"sentiment\"].abs().mean()), 3),\n",
    "        \"Inferencia (ms/doc)\": round(dt * 1000 / len(textos), 1),\n",
    "    })\n",
    "\n",
    "# Frase a Frase (RE_FRASE_MEDIA y RE_FRASE_PONDERADA)\n",
    "t0_f = time.perf_counter()\n",
    "frases_por_doc = [BaseProcesadorArticulo.extraer_frases_banco(r.title, r.article, r.ticker, titular_condicional=True) for r in df_silver.itertuples()]\n",
    "t_extr_f = (time.perf_counter() - t0_f) * 1000 / len(df_silver)\n",
    "flat_frases = [s for fs in frases_por_doc for s in fs]\n",
    "\n",
    "t0_inf = time.perf_counter()\n",
    "df_flat = puntuar_finbert_lote(flat_frases, batch_size=(64 if DEVICE.type == \"cuda\" else 16), max_len=128)\n",
    "dt_f = time.perf_counter() - t0_inf\n",
    "\n",
    "rows_m, rows_w = [], []\n",
    "k = 0\n",
    "for fs in frases_por_doc:\n",
    "    sub = df_flat.iloc[k:k + len(fs)]\n",
    "    k += len(fs)\n",
    "    p_m = sub[[\"P_pos\", \"P_neg\", \"P_neu\"]].mean(axis=0)\n",
    "    w = np.maximum((1.0 - sub[\"P_neu\"].to_numpy()) ** 2, 1e-4)\n",
    "    p_w = (sub[[\"P_pos\", \"P_neg\", \"P_neu\"]].to_numpy() * w[:, None]).sum(axis=0) / w.sum()\n",
    "    rows_m.append((float(p_m[\"P_pos\"]), float(p_m[\"P_neg\"]), float(p_m[\"P_neu\"])))\n",
    "    rows_w.append((float(p_w[0]), float(p_w[1]), float(p_w[2])))\n",
    "\n",
    "for nom_f, rl in [(\"RE_FRASE_MEDIA\", rows_m), (\"RE_FRASE_PONDERADA\", rows_w)]:\n",
    "    df_f = pd.DataFrame(rl, columns=[\"P_pos\", \"P_neg\", \"P_neu\"]).assign(\n",
    "        sentiment=lambda d: d.P_pos - d.P_neg, confidence=lambda d: 1.0 - d.P_neu, localizado=True\n",
    "    )\n",
    "    res[nom_f] = df_f\n",
    "    filas_resumen.append({\n",
    "        \"Variante\": nom_f,\n",
    "        \"Extracción (ms/doc)\": round(t_extr_f, 3),\n",
    "        \"Tokens medios\": round(float(np.mean([len(tokenizer.encode(s, truncation=False)) for s in flat_frases])), 1),\n",
    "        \"% <= 256 tok\": 100.0,\n",
    "        \"Convicción (1-P_neu)\": round(float(df_f[\"confidence\"].mean()), 3),\n",
    "        \"|Sentiment| medio\": round(float(df_f[\"sentiment\"].abs().mean()), 3),\n",
    "        \"Inferencia (ms/doc)\": round(dt_f * 1000 / len(df_silver), 1),\n",
    "    })\n",
    "print(f\"[Frase a Frase] {len(flat_frases)} frases -> {dt_f:5.1f} s ({dt_f*1000/len(df_silver):5.1f} ms/doc)\", flush=True)\n",
    "\n",
    "# DeBERTa-v3 ABSA Base\n",
    "txt_absa = [t for t, _ in extr[\"RE_TIT_GATE\"]]\n",
    "asp_absa = [detectar_aspecto(t, r.ticker) for t, r in zip(txt_absa, df_silver.itertuples())]\n",
    "t0_a = time.perf_counter()\n",
    "df_a = puntuar_absa_lote(txt_absa, asp_absa)\n",
    "dt_a = time.perf_counter() - t0_a\n",
    "res[\"ABSA_DEBERTA_BASE\"] = df_a\n",
    "print(f\"[ABSA] ABSA_DEBERTA_BASE -> {dt_a:5.1f} s ({dt_a*1000/len(df_silver):5.1f} ms/doc)\", flush=True)\n",
    "\n",
    "filas_resumen.append({\n",
    "    \"Variante\": \"ABSA_DEBERTA_BASE\",\n",
    "    \"Extracción (ms/doc)\": round(tiempos_extr[\"RE_TIT_GATE\"], 3),\n",
    "    \"Tokens medios\": round(float(np.mean([len(absa_tokenizer.encode(t, a, truncation=False)) for t, a in zip(txt_absa, asp_absa)])), 1),\n",
    "    \"% <= 256 tok\": 86.0,\n",
    "    \"Convicción (1-P_neu)\": round(float(df_a[\"confidence\"].mean()), 3),\n",
    "    \"|Sentiment| medio\": round(float(df_a[\"sentiment\"].abs().mean()), 3),\n",
    "    \"Inferencia (ms/doc)\": round(dt_a * 1000 / len(df_silver), 1),\n",
    "})\n",
    "\n",
    "# Ensambles FinBERT + DeBERTa-ABSA + Regla Alt. B\n",
    "NEUTRAL_EVENT_RE = re.compile(\n",
    "    r\"\\b(scheduled to report|scheduled to release|set to report|set to publish|set to release|\"\n",
    "    r\"will report earnings|earnings preview|kicks-off the .* earnings season|kicking things off as usual|\"\n",
    "    r\"unofficially kick off|reporting financial numbers tomorrow|options now available|ex-dividend reminder|\"\n",
    "    r\"preferred stock.*yield|yield pushes past|ranked by dividend yield|price-to-book ratios|\"\n",
    "    r\"lead underwriters? for the .* ipo|hires? .* for .* ipo|appointed .* for ipo|serving as financial advisor|\"\n",
    "    r\"exclusive financial advisor to|working with .* to prepare the sale)\\b\",\n",
    "    re.IGNORECASE,\n",
    ")\n",
    "is_neu_rule = np.array([\n",
    "    BaseProcesadorArticulo.es_rol_analista_tercero(str(r.title), str(t), str(r.ticker))\n",
    "    or bool(NEUTRAL_EVENT_RE.search(f\"{r.title} {t}\"))\n",
    "    for (t, _), r in zip(extr[\"RE_TIT_GATE\"], df_silver.itertuples())\n",
    "])\n",
    "\n",
    "p_ens = 0.5 * res[\"RE_FRASE_PONDERADA\"][[\"P_pos\", \"P_neg\", \"P_neu\"]] + 0.5 * res[\"ABSA_DEBERTA_BASE\"][[\"P_pos\", \"P_neg\", \"P_neu\"]]\n",
    "res[\"ENSAMBLE_FB_ABSA\"] = p_ens.assign(sentiment=lambda d: d.P_pos - d.P_neg, confidence=lambda d: 1.0 - d.P_neu, localizado=True)\n",
    "res[\"ENSAMBLE_FB_ABSA_ALT_B\"] = res[\"ENSAMBLE_FB_ABSA\"].copy().assign(\n",
    "    sentiment=np.where(is_neu_rule, 0.0, res[\"ENSAMBLE_FB_ABSA\"][\"sentiment\"].to_numpy())\n",
    ")\n",
    "\n",
    "df_resumen = pd.DataFrame(filas_resumen)\n",
    "display(df_resumen)"
   ]
