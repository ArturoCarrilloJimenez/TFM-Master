    "CSV_GT = PROJ_ROOT / \"scratch\" / \"finbert_pilot_v3_revision_manual.csv\"\n",
    "\n",
    "async def cargar_muestra_alineada(key=\"processed/huggingface/categorized_checkpoint.parquet\", n=150):\n",
    "    local_ckpt = PROJ_ROOT / \"data\" / \"silver_categorized_checkpoint.parquet\"\n",
    "    local_backup = PROJ_ROOT / \"data\" / \"processed_multisource_bancos_2010_2023.parquet\"\n",
    "    compact = get_compactor()\n",
    "    if local_ckpt.exists():\n",
    "        df = pd.DataFrame(compact.decompact(local_ckpt.read_bytes()))\n",
    "    else:\n",
    "        repo = get_storage_repository()\n",
    "        try:\n",
    "            try:\n",
    "                df = pd.DataFrame(compact.decompact(await repo.get(key)))\n",
    "            except Exception:\n",
    "                raw = local_backup.read_bytes() if local_backup.exists() else await repo.get(\"processed/huggingface/multisource_bancos_2010_2023.parquet\")\n",
    "                df = pd.DataFrame(compact.decompact(raw))\n",
    "        finally:\n",
    "            await repo.close()\n",
    "    if \"article\" not in df.columns and \"process_text\" in df.columns:\n",
    "        df[\"article\"] = df[\"process_text\"]\n",
    "\n",
    "    if CSV_GT.exists():\n",
    "        gt = pd.read_csv(CSV_GT)\n",
    "        lkp = df.drop_duplicates(subset=[\"ticker\", \"title\"]).set_index([\"ticker\", \"title\"])\n",
    "        aligned = []\n",
    "        for _, r in gt.iterrows():\n",
    "            k = (r[\"ticker\"], r[\"titular\"])\n",
    "            if k in lkp.index:\n",
    "                row_d = lkp.loc[k].to_dict()\n",
    "                row_d[\"ticker\"], row_d[\"title\"] = k\n",
    "                aligned.append(row_d)\n",
    "        if len(aligned) == len(gt):\n",
    "            return pd.DataFrame(aligned).reset_index(drop=True), gt\n",
    "\n",
    "    if \"is_ruido\" in df.columns:\n",
    "        df = df[~df[\"is_ruido\"]]\n",
    "    df = df[df[\"article\"].fillna(\"\").str.len() > 1500]\n",
    "    sub = df.sample(n=min(n, len(df)), random_state=42).reset_index(drop=True)\n",
    "    return sub, None\n",
    "\n",
    "df_silver, df_gt = await cargar_muestra_alineada(n=150)\n",
    "print(f\"[OK] Muestra cargada: {len(df_silver)} artículos | Ground Truth: {len(df_gt) if df_gt is not None else 'No disponible'}\")"
   ]
