# ==============================================================================
# AWS & S3 Storage Credentials
# ==============================================================================
DEFAULT_REGION_AWS=us-east-1 // Region de aws por defecto
AWS_ACCESS_KEY_ID=test // Credenciales del probeedor de S3
AWS_SECRET_ACCESS_KEY=test // Clave secreta del probeedor de S3

# ==============================================================================
# AWS STORAGE
# ==============================================================================
# Fallback / Default S3
S3_ENDPOINT_URL=http://localhost:9000 // Empoint al que te conectas
S3_BUCKET_NAME=tfm-master-prediccion-bancos-usa // Bucket destino del TFM donde se guardan los datasets finales
SCRAPER_S3_BUCKET_NAME=scraping-data-lake // Bucket origen del scraper donde se deposita la data compactada
S3_PREFIX_RAW_DATA=raw-data // Capa del bucket donde queremos apuntar
S3_REGION=us-east-1 // Region de aws

# ==============================================================================
# WEBSCRAPING DISTRIBUTED API PRODUCER
# ==============================================================================
SCRAPER_API_URL=https://webscraping-distributed.duckdns.org // URL del servicio de scraping distribuido
SCRAPER_BASIC_AUTH_USER= // Usuario de Basic Auth para el proxy inverso
SCRAPER_BASIC_AUTH_PASSWORD= // Contraseña de Basic Auth para el proxy inverso
